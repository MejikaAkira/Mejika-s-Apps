{
  // ============================================
  // 特徴点検出設定
  // ============================================
  "feature_detector": {
    // 特徴点検出アルゴリズム: "SIFT" または "ORB"
    // - SIFT: 高精度だが遅い（CPUのみ）
    // - ORB: 高速だが精度はやや低い（CPU/GPU対応）
    "type": "ORB",
    
    // 特徴点検出デバイス: "CPU" または "GPU"
    // - SIFTはCPUのみ（GPU非対応）
    // - ORBはCPU/GPU両方対応
    "device": "CPU"
  },
  
  // ============================================
  // 記述子マッチング設定
  // ============================================
  "descriptor_matching": {
    // 記述子マッチングデバイス: "CPU" または "GPU"
    // - GPU: 大規模データで高速（数千個の特徴点）
    // - CPU: 小規模データで高速（数百個の特徴点）
    "device": "GPU"
  },
  
  // ============================================
  // 画像処理設定
  // ============================================
  "image_processing": {
    // 画像シャープ化処理: "auto", "CPU", "GPU"
    // - auto: 画像サイズに応じて自動選択（1280x720以上でGPU）
    // - CPU: 常にCPUで処理（推奨：小規模データで高速）
    // - GPU: 常にGPUで処理
    "sharpen": "CPU",
    
    // リサイズ処理: "auto", "CPU", "GPU"
    // - auto: 画像サイズに応じて自動選択（1280x720以上でGPU）
    // - CPU: 常にCPUで処理（推奨：GPU転送オーバーヘッドを回避）
    // - GPU: 常にGPUで処理
    "resize": "CPU",
    
    // ガウシアンブラー処理: "auto", "CPU", "GPU"
    // - auto: 画像サイズに応じて自動選択（1280x720以上でGPU）
    // - CPU: 常にCPUで処理（推奨：GPU転送オーバーヘッドを回避）
    // - GPU: 常にGPUで処理
    "gaussian_blur": "CPU",
    
    // 画像変換（warpPerspective）処理: "auto", "CPU", "GPU"
    // - auto: 画像サイズに応じて自動選択（1280x720以上でGPU）
    // - CPU: 常にCPUで処理（推奨：GPU転送オーバーヘッドを回避）
    // - GPU: 常にGPUで処理
    "warp_perspective": "CPU",
    
    // 差分計算（absdiff）処理: "auto", "CPU", "GPU"
    // - auto: 画像サイズに応じて自動選択（1280x720以上でGPU）
    // - CPU: 常にCPUで処理（推奨：GPU転送オーバーヘッドを回避）
    // - GPU: 常にGPUで処理
    "absdiff": "CPU"
  },
  
  // ============================================
  // ORB設定（ORB使用時のみ有効）
  // ============================================
  "orb": {
    // 最大特徴点数（デフォルト: 500）
    // - 多いほど精度が上がるが処理時間が増える
    "nfeatures": 500,
    
    // スケールファクター（デフォルト: 1.2）
    // - 特徴点検出のスケール間隔
    "scaleFactor": 1.2,
    
    // ピラミッドレベル数（デフォルト: 8）
    // - 多いほどスケール不変性が向上
    "nlevels": 8
  },
  
  // ============================================
  // SIFT設定（SIFT使用時のみ有効）
  // ============================================
  "sift": {
    // 最大特徴点数（0=無制限、デフォルト: 0）
    // - 0: 制限なし
    // - 正の値: 指定した数の特徴点を検出
    "max_features": 0,
    
    // コントラスト閾値（デフォルト: 0.04）
    // - 低いほど多くの特徴点を検出
    "contrast_threshold": 0.04,
    
    // エッジ閾値（デフォルト: 10）
    // - 高いほどエッジに強い特徴点を検出
    "edge_threshold": 10,
    
    // ガウシアンシグマ（デフォルト: 1.6）
    // - 特徴点検出のスケール
    "sigma": 1.6
  },
  
  // ============================================
  // リアルタイム動画処理設定
  // ============================================
  "realtime_video": {
    // カメラ設定
    "camera": {
      // カメラデバイスID（0=デフォルトPCカメラ、1,2...=他のカメラ）
      "device_id": 0,
      
      // カメラのFPS（デフォルト: 30）
      // カメラごとに異なる場合は設定を変更
      "fps": 30
    },
    
    // 差分検出設定
    "difference": {
      // 差分検出の閾値（差分ピクセル数）
      // 画像サイズに応じて調整（例: 640x480なら約1500、1280x720なら約4600）
      // デフォルト: 5000（一般的な解像度で0.5-1%程度）
      "threshold_pixels": 5000,
      
      // 差分検出の閾値（差分ピクセル率、0.0-1.0）
      // デフォルト: 0.005（0.5%）
      "threshold_ratio": 0.005,
      
      // ノイズ除去の閾値（差分値がこの値未満のピクセルはノイズとして除外）
      // カメラノイズは通常10-30程度、実際の変化は50以上
      // デフォルト: 20（ノイズを除外しつつ、実際の変化を検出）
      // 環境（カメラ品質、照明条件）に応じて調整が必要
      "noise_threshold": 20
    },
    
    // 位置補正の最適化設定
    "alignment": {
      // ホモグラフィを再利用する時間（秒）
      // 30FPSの場合、1フレームは約0.033秒
      // 0.1秒（約3フレーム分）: 精度とパフォーマンスのバランス
      // 0.0秒: 毎フレーム計算（最高精度、処理時間に余裕がある場合は推奨）
      "homography_reuse_seconds": 0.1
    },
    
    // 保存設定
    "save": {
      // 差分が検出されなかったフレームをarchiveに入れる
      "archive_no_diff": true,
      
      // archiveフォルダのパス（相対パス）
      "archive_path": "video_outputs/archive"
    },
    
    // バッファ設定
    "buffer": {
      // フレームバッファの最大サイズ（処理結果を保持する数）
      "frame_buffer_size": 10,
      
      // フレームキューの最大サイズ（カメラから取得したフレームを保持する数）
      "frame_queue_size": 5
    },
    
    // GUI表示設定
    "display": {
      // GUI表示を有効にするか（true/false）
      // デフォルト: true（開発・検証時）
      // サーバー環境やヘッドレス環境では false に設定
      "enable": true,
      
      // 表示するウィンドウ
      // - "original": 元のフレーム
      // - "difference": 差分画像
      // - "both": 両方表示
      "show": "both"
    },
    
    // ネットワーク送信設定
    "streaming": {
      // ネットワーク送信を有効にするか（true/false）
      // 初期状態（GUIで変更可能）
      "enable": false,
      
      // 送信プロトコル: "udp" または "websocket"（将来対応）
      // まずはUDPで実装、将来的にWebSocket対応
      "protocol": "udp",
      
      // 送信ポート
      "port": 8080,
      
      // 送信アドレス（0.0.0.0=全インターフェース）
      "address": "0.0.0.0"
    }
  }
}
